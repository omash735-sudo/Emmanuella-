{
  "name": "girlfriends-day-gift",
  "version": "2.0.0",
  "private": true,
  "description": "✨ A magical interactive digital gift experience for Girlfriend's Day. A romantic storybook with memories, music, and surprises.",
  "author": {
    "name": "Your Man ❤️",
    "email": "your-email@example.com",
    "url": "https://your-website.com"
  },
  "homepage": "https://your-domain.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/omash735-sudo/Emmanuella.git"
  },
  "bugs": {
    "url": "https://github.com/omash735-sudo/Emmanuella/issues"
  },
  "keywords": [
    "girlfriend",
    "gift",
    "love",
    "romantic",
    "surprise",
    "anniversary",
    "valentine",
    "digital-gift",
    "storybook",
    "interactive"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky install",
    "prebuild": "npm run type-check",
    "predeploy": "npm run build",
    "analyze": "ANALYZE=true npm run build",
    "clean": "rm -rf .next node_modules",
    "reset": "npm run clean && npm install"
  },
  "dependencies": {
    "@next/font": "^14.0.4",
    "framer-motion": "^10.16.16",
    "gsap": "^3.12.4",
    "lucide-react": "^0.469.0",
    "next": "14.0.4",
    "react": "^18",
    "react-dom": "^18",
    "react-intersection-observer": "^9.5.3",
    "react-youtube": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@next/bundle-analyzer": "^14.0.4",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "14.0.4",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "postcss": "^8",
    "prettier": "^3.1.1",
    "tailwindcss": "^3.3.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18.17.0",
    "npm": ">=9.6.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all",
      "not ie 11"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,scss,md,json}": [
      "prettier --write"
    ]
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "printWidth": 100,
    "bracketSpacing": true,
    "bracketSameLine": false,
    "arrowParens": "avoid",
    "endOfLine": "lf",
    "plugins": []
  },
  "eslintConfig": {
    "extends": [
      "next/core-web-vitals",
      "prettier"
    ],
    "rules": {
      "react/no-unescaped-entities": "off",
      "@next/next/no-img-element": "off",
      "react-hooks/exhaustive-deps": "warn"
    }
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "volta": {
    "node": "18.17.0",
    "npm": "9.6.0"
  }
}
